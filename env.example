ANTHROPIC_API_KEY=
YT_API_KEY=
PEXELS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Channel settings
NICHE=amazing science and tech facts
MY_ANGLE=friendly, curious, gives a clear personal opinion
SCRIPT_LANGUAGE=simple Indian English
